{
  "name": "ka-rf-designer-frontend",
  "productName": "Ka-band RF Designer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently --kill-others \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "web:dev": "vite",
    "build": "vite build",
    "test": "vitest run",
    "backend:build": "node scripts/build-backend.cjs",
    "desktop:dir": "npm run backend:build && npm run build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --dir",
    "desktop:pack": "npm run backend:build && npm run build && electron-builder",
    "preview": "vite preview"
  },
  "dependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/test-utils": "^2.5.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.0.12",
    "jsdom": "^30.1.1",
    "vite": "^7.0.0",
    "vitest": "^5.0.3",
    "wait-on": "^8.0.4"
  },
  "build": {
    "appId": "com.solidchallenge.karfdesigner",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "python-dist/",
        "to": "backend/"
      },
      {
        "from": "../backend/config.json",
        "to": "app-resources/backend/config.json"
      },
      {
        "from": "../data/catalog/manufacturer_product_seeds.csv",
        "to": "app-resources/data/catalog/manufacturer_product_seeds.csv"
      },
      {
        "from": "../data/components.csv",
        "to": "app-resources/data/components.csv"
      },
      {
        "from": "../data/mcs.csv",
        "to": "app-resources/data/mcs.csv"
      },
      {
        "from": "../references/",
        "to": "app-resources/references/",
        "filter": [
          "*.xlsx"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "category": "Science",
      "target": [
        "AppImage"
      ]
    }
  },
  "allowScripts": {
    "electron@44.5.1": true,
    "esbuild@0.28.2": true
  }
}
